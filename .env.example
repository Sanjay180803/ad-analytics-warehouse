# Copy to .env (git-ignored). Astro loads .env into every Airflow container.
# Plain KEY=value lines only: no quotes, no spaces around '='.

# --- AWS (Spark S3A, the S3 sensor and boto3 all use these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=your-bucket-name

# --- Dataset
CRITEO_ANCHOR_DATE=2025-01-01

# --- Snowflake (key-pair auth for the AIRFLOW_SVC service user), used by dbt.
# The Airflow connection for COPY INTO is in airflow_settings.yaml.
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=AIRFLOW_SVC
# path INSIDE the container; the file is include/secrets/rsa_key.p8 on your PC
SNOWFLAKE_PRIVATE_KEY_PATH=/usr/local/airflow/include/secrets/rsa_key.p8
DBT_TARGET=prod

# --- Spark sizing inside the Astro container
SPARK_DRIVER_MEMORY=4g

# --- Optional: alerts for task failures and deadline (SLA) misses
SLACK_WEBHOOK_URL=
