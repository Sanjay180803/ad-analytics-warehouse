# Copy to .env (git-ignored). Astro loads .env into every Airflow container.

# --- AWS (Spark S3A, the S3 sensor and boto3 all use the default credential chain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=your-bucket-name

# --- Dataset
CRITEO_ANCHOR_DATE=2025-01-01

# --- Snowflake (key-pair auth for the airflow_svc service user)
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=AIRFLOW_SVC
# path INSIDE the container; put rsa_key.p8 in include/secrets/ (git-ignored)
SNOWFLAKE_PRIVATE_KEY_PATH=/usr/local/airflow/include/secrets/rsa_key.p8
DBT_TARGET=prod

# Airflow connection used by the COPY INTO tasks (role LOADER, warehouse LOADING_WH)
AIRFLOW_CONN_SNOWFLAKE_LOADER='{"conn_type": "snowflake", "login": "AIRFLOW_SVC", "schema": "CRITEO", "extra": {"account": "orgname-accountname", "database": "RAW", "warehouse": "LOADING_WH", "role": "LOADER", "private_key_file": "/usr/local/airflow/include/secrets/rsa_key.p8"}}'
AIRFLOW_CONN_AWS_DEFAULT='{"conn_type": "aws", "extra": {"region_name": "us-east-1"}}'

# --- Spark sizing inside the Astro worker container
SPARK_DRIVER_MEMORY=4g

# --- Optional: alerts for task failures and deadline (SLA) misses
SLACK_WEBHOOK_URL=
